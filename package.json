{
  "name": "versetile",
  "private": true,
  "author": {
    "name": "Mark Berry",
    "email": "mark@berry.sh"
  },
  "version": "0.1.0",
  "type": "module",
  "description": "Versetile — a songwriter's workstation. Chords, scales, progressions, and a bar-grid looper.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^4.123.0"
  }
}
